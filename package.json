{
  "name": "jet-lider",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "node --env-file=.env.test.local node_modules/vitest/vitest.mjs run tests/supabase.live.test.ts",
    "format": "prettier --write src tests scripts *.ts *.mjs",
    "db:types": "supabase gen types typescript --local > src/types/database.generated.ts",
    "bootstrap": "node --env-file=.env.local scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "supabase": "^2.76.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
